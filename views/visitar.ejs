<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Home</title>
        <!-- Estilos -->
        <link rel="stylesheet" href="/styles/GlobalStyle.css">
        <link rel="stylesheet" href="/styles/mainStyle.css">
        <link rel="stylesheet" href="/styles/styleVisitar.css">
        <!-- Google material icons -->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    </head>
    <body>
        <div class="main-container">
            <header class="main-logo">
                <h1 class="logo"><img src="/assets/images/logo.webp" alt="Logo do site"></h1>
                <!-- Menu de navegação -->
                <%- include('./layouts/menu'); %>
            </header>
            <div class="main-image"></div>
            <main class="main-content">
                <section class="info-content">
                    <img src="../assets/images/logo.webp" alt="">
                    <p>Planejando e realizando sonhos</p>
                </section>
                <section class="card-title">
                    <% if(imovel.imagem_principal){ %> 
                        <img src="data:image/jpeg;base64, <%= imovel.imagem_principal.toString('base64') %>" 
                            alt="Imagem Principal">    
                    <% }else{ %> 
                        <p>Imagem principal indisponível </p>    
                    <% } %>
                </section>
                <section class="imovel-detalhes">
                    <h2><%= imovel.Nome %></h2>
                    <p><%= imovel.Descricao %></p>
                    <h3>Localização</h3>
                    <p><%= imovel.Endereco %></p>
                    <h3>Preço</h3>
                    <p>R$ <%= imovel.Preco %></p>
                </section>
                <section class="imovel-imagens">
                    <h3>Imagens do Imóvel</h3>
                    <% if(imagens && imagens.length > 0){ %> 
                        <div class="galeria">
                            <% imagens.forEach(imagem => { %> 
                                <div class="imagem-item">
                                    <img src="<%= imagem.URL %>" alt="Imagem do imóvel">
                                </div>
                            <% }); %> 
                        </div>    
                    <% }else{ %> 
                        <p>Nenhuma imagem disponível.</p>
                    <% } %>
                </section>
            </main>
            <!--Footer-->
            <%- include('./layouts/footer'); %>
            <!--Footer-->
        </div> 
    </body>
    <script src="/scripts/btnVerMais.js"></script>
</html>