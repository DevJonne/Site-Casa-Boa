<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Home</title>
        <!-- Estilos -->
        <link rel="stylesheet" href="/styles/GlobalStyle.css">
        <link rel="stylesheet" href="/styles/mainStyle.css">
        <!-- <link rel="stylesheet" href="/styles/styleCliente.css"> -->
        <!-- Google material icons -->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    </head>
    <body>
        <div class="main-container">
            <header class="main-logo">
                <h1 class="logo"><img src="/assets/images/logo.webp" alt="Logo do site"></h1>
                <nav class="navigation">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/faleConosco">Contate-nos</a></li>
                        <% if(user){ %>
                            <% if (user.tipo === "administrador"){ %>
                                <li><a href="/admin">Admin</a></li>
                            <% }else if(user.tipo === 'agente'){ %>
                                <li><a href="/agente">Agente</a></li>
                            <% }else if(user.tipo === 'cliente'){ %>
                                <li><a href="/cliente">Cliente</a></li>
                            <% } %>
                            <li><a href="/logout">Sair</a></li>
                        <% }else{ %>
                            <li><a href="/entrar">Entrar</a></li>
                        <% } %>
                        <span class="material-symbols-outlined">
                            search
                        </span>
                    </ul>
                </nav>
            </header>
            <div class="main-image"></div>
            <main class="main-content">
                <h2>Área do Cliente</h2>
                <p>Bem-vindo, <%= user.nome %></p>
                
                <section class="imoveis-favoritos">
                    <h3>Meus imóveis favoritos</h3>
                    <% if(imoveisFavoritos.lenght){ %> 
                        <ul class="lista-favoritos">
                            <% imoveisFavoritos.forEach(imovel => { %> 
                                <li class="item-favorito">
                                    <p><%= imovel.Descricao %></p>
                                </li>
                            <% }); %>
                        </ul>
                    <% }else{ %> 
                        <p>Nenhum imóvel favorito ainda.</p>
                    <% } %>
                </section>
            </main>
            <!--Footer-->
            <%- include('./layouts/footer'); %>
            <!--Footer-->
        </div> 
    </body>
</html>