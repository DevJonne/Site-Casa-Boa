<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Home</title>
        <!-- Estilos -->
        <link rel="stylesheet" href="/styles/GlobalStyle.css">
        <link rel="stylesheet" href="/styles/mainStyle.css">
        <link rel="stylesheet" href="/styles/styleHome.css">
        <!-- Google material icons -->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    </head>
    <body>
        <div class="main-container">
            <header class="main-logo">
                <h1 class="logo"><img src="/assets/images/logo.webp" alt="Logo do site"></h1>
                <nav class="navigation">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/faleConosco">Contate-nos</a></li>
                        <li><a href="/entrar">Entrar</a></li>
                        <span class="material-symbols-outlined">
                            search
                        </span>
                    </ul>
                </nav>
            </header>
            <div class="main-image"></div>
            <main class="main-content">
                <section class="info-content">
                    <img src="../assets/images/logo.webp" alt="">
                    <p>Planejando e realizando sonhos</p>
                    <div class="btn-actions">
                        <button class="btn-buscar"><a href="/faleConosco">Entrar em contato</a></button>
                        <button class="btn-quemSomos"><a href="#sobre">Quem somos</a></button>
                    </div>
                </section>
                <% categoriasComImoveis.forEach(item => { %>
                    <section class="categorias categoria-<%= item.categoria.Nome.toLowerCase() %>">
                        <h3 class="titulo-categorias"><%= item.categoria.Nome %> disponíves para venda</h3>
                        <div class="conteudo-categorias" id="conteudo-<%= item.categoria.idCategorias %>">
                            <% item.imoveis.forEach(imovel => { %>
                                <article class="card-categorias">
                                    <img src="../assets/images/imagem-exemplo.jpeg" 
                                        alt="Imagem para visualização prévia">
                                    <div class="conteudo-card">
                                        <p><%= imovel.Descricao %></p>
                                    </div>
                                    <button class="btn-card">Visitar</button>
                                </article> 
                            <% }); %> 
                        </div>
                            <% if (item.imoveis.length > 3) { %>
                                <button onclick="verMais(<%= item.categoria.idCategorias %>)" class="btn-card btn-ver-mais">Ver mais</button>
                            <% } %>
                    </section>
                <% }); %>          
                <section id="sobre">
                    <article class="left">
                        <h2 class="titulo-sobre">Focamos em oferecer profissionalismo e competência</h2>
                        <p class="descricao-sobre"> 
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                            Lorem Ipsum has been the industry's standard dummy text ever since the 1500s,
                            when an unknown printer took a galley of type and scrambled it to make a type 
                            specimen book.
                        </p>
                    </article>
                    <article class="right">
                        <div class="visao01-sobre">
                            <img src="/assets/images/trust.png" alt="Confiança" class="icon-valores">
                            <h3>Confiança</h3>
                            <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                        </div>
                        <div class="visao02-sobre">
                            <img src="/assets/images/credibility.png" alt="Confiança" class="icon-valores">
                            <h3>Credibilidade</h3>
                            <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                        </div>
                        <div class="visao03-sobre">
                            <img src="/assets/images/ethics.png" alt="Confiança" class="icon-valores">
                            <h3>Ética</h3>
                            <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                        </div>
                    </article>
                </section>
            </main>
            <!--Footer-->
            <footer>
                <p>&copy; 2023 - Todos os direitos reservados</p>
                <nav class="footer">
                    <ul>
                        <li><a href="#">Termos de uso</a></li>
                        <li><a href="#">Política de privacidade</a></li>
                        <li><a href="#">Sobre nós</a></li>
                        <li><a href="#">Contato</a></li>
                    </ul>
                </nav>
            </footer>
        <!--Footer-->
        </div> 
    </body>
    <script src="/scripts/btnVerMais.js"></script>
</html>