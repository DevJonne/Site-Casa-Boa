                        <li class="profile"><img src="/assets/images/pteste.jpg" alt="Ícone de Perfil">
                         profile "Imagem de um emoji"-->
                    </ul>
                </nav>
            </header>

            <!--header-->



            <!--Conteúdo do meio da página-->
          <!--Imagem do background-->  <div class="main-image"></div>
            <main class="main-content">
                <section class="info-content">
                    <img src="../assets/images/logo.webp" alt="">
                    <p>Planejando e realizando sonhos</p>
                    <div class="buttons">
                        <button class="btn"><a href="/busca">Buscar imóvel</a></button>
