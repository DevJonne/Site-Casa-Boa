            <!--header-->





<!-- Seção de Imóveis -->
<section>
    <div class="container">
        <div class="filters">
          <h3>Quarto(s)</h3>
          <label><input type="checkbox"> 1 Quarto</label>
          <label><input type="checkbox"> 2 Quartos</label>
          <label><input type="checkbox"> 3 Quartos</label>
          <label><input type="checkbox"> 4 ou mais</label>
    
          <h3>Garagem(ns)</h3>
          <label><input type="checkbox"> 1 Espaço</label>
          <label><input type="checkbox"> 2 Espaços</label>
          <label><input type="checkbox"> 3 Espaços</label>
          <label><input type="checkbox"> 4 ou mais</label>
    
          <h3>Sala(s)</h3>
          <label><input type="checkbox"> 1 Sala</label>
          <label><input type="checkbox"> 2 Salas</label>
          <label><input type="checkbox"> 3 Salas</label>
          <label><input type="checkbox"> 4 ou mais</label>
    
          <h3>Cozinha(s)</h3>
          <label><input type="checkbox"> 1 Cozinha</label>
          <label><input type="checkbox"> 2 Cozinhas</label>
          <label><input type="checkbox"> 3 Cozinhas</label>
          <label><input type="checkbox"> 4 ou mais</label>
    
          <h3>Banheiro(s)</h3>
          <label><input type="checkbox"> 1 Banheiro</label>
          <label><input type="checkbox"> 2 Banheiros</label>
          <label><input type="checkbox"> 3 Banheiros</label>
          <label><input type="checkbox"> 4 ou mais</label>
    
          <h3>Cômodo(s) livre(s)</h3>
          <label><input type="checkbox"> 1 Cômodo</label>
          <label><input type="checkbox"> 2 Cômodos</label>
          <label><input type="checkbox"> 3 Cômodos</label>
          <label><input type="checkbox"> 4 ou mais</label>
        </div>
    
        <div class="property-list">
          <div class="property-card">
            <img src="assets/images/img5.webp" alt="Imóvel">
            <div class="property-info">
              <h4>Valor do imóvel</h4>
              <p>R$280,000</p>
              <p>Parcelas de até 2,500</p>
              <p>Condomínio: R$0</p>
              <p>IPTU: 12x R$0</p>
              <button><a href="/produtos">Visitar</a></button>
            </div>
          </div>
    
          <!-- Repetir o card conforme necessário -->
        </div>
      </div>
</section>

